{
  "name": "@doxlabs/cli",
  "version": "0.2.0",
  "description": "The unified dox CLI — author content + config; the framework stays a hidden runtime",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "dox": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "create-dox": "*",
    "@doxlabs/mcp": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.15"
  }
}
