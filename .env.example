# Dox environment variables (copy to .env.local)

# Site URL (required for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3040

# Admin dashboard — set to enable /admin analytics
DOX_ADMIN_PASSWORD=change-me

# Optional: separate signing secret (defaults to admin password)
# DOX_ADMIN_SECRET=

# Optional: password-protect the entire docs site
# DOX_ACCESS_PASSWORD=

# Optional: internal analytics ingest secret
# DOX_ANALYTICS_SECRET=

# AI chat widget
# ANTHROPIC_API_KEY=
